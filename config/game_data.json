  "memories": [
    {"id": "awakening", "title": "记录 00 / 苏醒", "text": "生命维持恢复的瞬间，你听见广播改变了一个音节。它不是在欢迎幸存者。它在确认实验继续。"},
    {"id": "automation_guide", "title": "操作指引 / 自动化起步", "unlock_hint": "完成苏醒教学", "text": "下一步先使用教学赠送的常规数据封装积累协议能量。达到 36 E 后，前往“04 终端”购买第一组算力；这会解锁序列探针。返回“01 解译”，为通道选择序列探针，AI 就会开始猜测。AI 运行期间可在“05 科技”反复提升低价产能等级；自动结算每级覆盖算力优先级靠前的一条通道。"},
    {"id": "feedback_guide", "title": "操作指引 / 反馈判读", "unlock_hint": "完成苏醒教学", "text": "“位置正确”表示数字和位置均正确；“数字错位”表示数字存在但位置错误。破解成功后需要执行结算；被自动结算科技覆盖的通道可省略手动确认。特殊协议可能只返回命中总量或正确位置，DOS 标题会注明当前反馈类型。"},
    {"id": "collection_guide", "title": "操作指引 / 收藏被动", "unlock_hint": "首次获得收藏品", "text": "收藏品第一次取得后，其“持有效果”立即永久生效。集齐同一系列后，该系列内每一件收藏的持有效果都会翻倍；重复品会自动分解为计算碎片。"},
    {"id": "compute_guide", "title": "操作指引 / 算力与 AI", "unlock_hint": "首次购买算力", "text": "算力是 AI 持续占用的运行容量，不会随猜测消耗。为通道选择 AI 后，它会经历协议握手和逐次决策；算力不足的通道进入等待队列。建立多条通道后，可在解译界面调整算力优先级；已经开始的握手或推演不会被抢占。自动结算每级覆盖优先级靠前的一条通道。"},
    {"id": "first_consumable", "title": "记录 01 / 损耗", "unlock_hint": "成功结算一次消耗型节点", "text": "节点外壳上的焦痕与你掌心旧伤完全吻合。你以前也启动过它。也许不止一次。"},
    {"id": "awakening_collection", "title": "记录 02 / 封签", "unlock_hint": "集齐“苏醒舱残留”系列", "text": "休眠舱封签记录了多次开启。每一次，舱内都是同一个人。"},
    {"id": "maintenance_memory", "title": "记录 03 / 维护员", "unlock_hint": "集齐“维护环构件”系列", "text": "维护日志将你的权限标为“临时”，有效期却横跨了四百三十七年。"},
    {"id": "security_memory", "title": "记录 04 / 封锁", "unlock_hint": "集齐“安保残骸”系列", "text": "安保系统没有阻止你进入。它阻止设施里的某样东西离开。"},
    {"id": "long_chain_memory", "title": "记录 05 / 长链", "unlock_hint": "集齐“长链通讯遗物”系列", "text": "低频链条穿过所有区域，像一条被刻意隐藏的神经。"},
    {"id": "prism_memory", "title": "记录 06 / 星图", "unlock_hint": "集齐“棱镜档案”系列", "text": "棱镜保存的航线终点不是某颗恒星，而是一段被从坐标系中挖掉的空白。"},
    {"id": "multispectral_memory", "title": "记录 07 / 多谱", "unlock_hint": "集齐“多谱编码样本”系列", "text": "每套进制都描述了同一座设施，却没有任何两套得出相同的房间数量。"},
    {"id": "deep_validation_memory", "title": "记录 08 / 校验", "unlock_hint": "集齐“深层校验遗物”系列", "text": "终端不是在判断答案正确与否。它在判断你是否会接受它给出的反馈。"},
